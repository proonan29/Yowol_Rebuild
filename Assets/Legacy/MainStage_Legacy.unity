  - "A,D\uB97C \uC774\uC6A9\uD574, \uC55E\uC73C\uB85C \uAC00\uC2ED\uC2DC\uC694."
  - "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uACF5\uACA9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  topCinematicBarGroup: {fileID: 0}
  bottomCinematicBarGroup: {fileID: 954401300}
  bgmAudioSource: {fileID: 749315433}
  bgmFadeSpeed: 2
  cutsceneList:
  - cutsceneSprite: {fileID: 156178388912589208, guid: 0706135363b3b0c4690e399288601f0c, type: 3}
    dialogueText: "\uD06C\uC74F.. \uC7A1\uD788\uACA0\uC5B4..!!"
    bgmClip: {fileID: 8300000, guid: c042a5fb2545fd14a8b5de3005fa2dad, type: 3}
  - cutsceneSprite: {fileID: 156178388912589208, guid: 0706135363b3b0c4690e399288601f0c, type: 3}
    dialogueText: "\uBE68\uB9AC \uBC97\uC5B4\uB098\uC57C \uB3FC..!"
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: 2427607150729607536, guid: 9a9a9a74300df6445b9dab568233c5c6, type: 3}
    dialogueText: "\uC800\uAE30 \uACE8\uBAA9\uAE38.. \uC800\uAE30\uB85C \uAC00\uC790..!"
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: 4320696607758130815, guid: f5b48de59ba0fba4eab80baf81ab89a0, type: 3}
    dialogueText: "\uD734.. \uACA8\uC6B0 \uB530\uB3CC\uB838\uB124.."
    bgmClip: {fileID: 8300000, guid: 6236343027744e047ad8294addc430df, type: 3}
  - cutsceneSprite: {fileID: -905815461957763676, guid: 5132664bed5c60e4e88c46a064068a24, type: 3}
    dialogueText: "\uC5B4..? \uC800\uAC74 \uBB50\uC9C0?"
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: -342681029711364793, guid: f2563ab38efa47c4ca62e6a34f079221, type: 3}
    dialogueText: "\uBD88..\uAF43?"
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: -478819525755448939, guid: 432771e6a41d0874c938ff629b2bf83c, type: 3}
    dialogueText: "(\uB760..\uB9C1)"
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: -478819525755448939, guid: 432771e6a41d0874c938ff629b2bf83c, type: 3}
    dialogueText: "??? : \uC548\uB155\uD558\uC138\uC694. \uC0C8\uB85C\uC6B4 \u300E\uCC3D\uC870\uC790\u300F\uB2D8"
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: -478819525755448939, guid: 432771e6a41d0874c938ff629b2bf83c, type: 3}
    dialogueText: "\uB10C.. \uB204\uAD6C\uC57C?"
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: 1686370261284447185, guid: a4a702a1627d38c4e8e9375d59c2b55c, type: 3}
    dialogueText: "\uC81C \uC774\uB984\uC740 \u300E\uC7BF\uBE5B\uC758 \uBD88\u300F"
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: 1686370261284447185, guid: a4a702a1627d38c4e8e9375d59c2b55c, type: 3}
    dialogueText: "\uC800\uB294 \u300E1\uB300 \uCC3D\uC870\uC790\u300F\uB2D8\uC758 \uC77C\uBD80\uC785\uB2C8\uB2E4."
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: 1686370261284447185, guid: a4a702a1627d38c4e8e9375d59c2b55c, type: 3}
    dialogueText: "\uC774 \uC138\uACC4\uC758 \uC0C8\uB85C\uC6B4 \uAC00\uC774\uB4DC\uC785\uB2C8\uB2E4."
    bgmClip: {fileID: 0}
  - cutsceneSprite: {fileID: 1686370261284447185, guid: a4a702a1627d38c4e8e9375d59c2b55c, type: 3}
    dialogueText: "\uC6B0\uC120 \uBAA9\uC801\uC9C0\uB85C \uD5A5\uD558\uC2DC\uC8E0. \uC548\uB0B4\uD574\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    bgmClip: {fileID: 0}
  typeSpeed: 0.05
  fadeOutSpeed: 2
