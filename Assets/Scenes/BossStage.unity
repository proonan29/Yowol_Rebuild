  ambienceVolume: 0.3
  guideName: "\uC7BF\uBE5B\uC758 \uBD88"
  openingLines: []
  clearLines:
  - "\uD574\uB0C8\uC5B4\uC694, \uCC3D\uC870\uC790\uB2D8!"
  - "\uB2EC\uBE5B\uC774... \uC870\uAE08 \uB3CC\uC544\uC628 \uAC83 \uAC19\uC544\uC694."
