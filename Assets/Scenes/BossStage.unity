  boss: {fileID: 230204450}
  bossIntroLines:
  - "\uC800 \uB140\uC11D\uC774 \uC0AC\uD749\uC758 \uC77C\uC6D0, \u300E\uD63C\uB3C8\u300F\uC774\uC5D0\uC694!"
  - "\uBCF4\uB77C\uC0C9 \uD574\uACE8 \uC0AC\uC2AC\uC774 \uBC15\uD788\uBA74 \uACF5\uACA9\uD558\uC138\uC694. \uD63C\uB3C8\uC744 \uBB34\uB108\uB728\uB9B4 \uC218 \uC788\uC5B4\uC694!"
  - "\uADF8\uB9AC\uACE0... \uD63C\uB3C8\uC774 \uD798\uC744 \uBAA8\uC73C\uBA74 \uC81C\uB2E8\uC744 \uBD80\uC234\uC57C \uD574\uC694. \uC870\uC2EC\uD558\uC138\uC694, \uCC3D\uC870\uC790\uB2D8!"
  victoryText: "\uC0AC\uD749\uC758 \uC77C\uC6D0 \u300E\uD63C\uB3C8\u300F\uC744 \uC4F0\uB7EC\uB728\uB838\uC2B5\uB2C8\uB2E4.\n\n\uC694\uC6D4 : \uD63C\uB839\uC758 \uB2EC  (\uB370\uBAA8 \uD074\uB9AC\uC5B4)"
