  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Yowol.StageController
  stageTitle: STAGE 1
  stageSubtitle: "\uBE44 \uB0B4\uB9AC\uB294 \uC625\uC0C1 \uACE8\uBAA9"
  spawnPoint: {fileID: 1237435634}
  cameraBounds:
    serializedVersion: 2
    x: -65
    y: -12.58
    width: 111.5
    height: 14
  cameraSize: 5
  cameraOffset: {x: 0, y: 2.1}
  bgm: {fileID: 8300000, guid: 6236343027744e047ad8294addc430df, type: 3}
  ambience: {fileID: 8300000, guid: 343414efde6e09242bad5b4e84500ed2, type: 3}
  ambienceVolume: 0.3
  guideName: "\uC7BF\uBE5B\uC758 \uBD88"
  openingLines:
  - "A, D\uB97C \uC774\uC6A9\uD574 \uC55E\uC73C\uB85C \uAC00\uC2ED\uC2DC\uC624. W\uB098 \uC704\uCABD \uBC29\uD5A5\uD0A4\uB85C \uC810\uD504\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "Space\uB098 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uACF5\uACA9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "E, Q\uB85C \uBB34\uAE30\uB9C8\uB2E4 \uB2E4\uB978 \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC5B4\uC694."
  clearLines:
  - "\uC774 \uADFC\uCC98\uC758 \uD63C\uB839\uC740 \uBAA8\uB450 \uC815\uB9AC\uB410\uC5B4\uC694. \uC55E\uC73C\uB85C \uAC00\uC2DC\uC8E0."
  requireClear: 1
  exit: {fileID: 1521322467}
  boss: {fileID: 0}
  bossIntroLines: []
  victoryText: "\uC0AC\uD749\uC758 \uC77C\uC6D0 \u300E\uD63C\uB3C8\u300F\uC744 \uC4F0\uB7EC\uB728\uB838\uC2B5\uB2C8\uB2E4.\n\n\uC694\uC6D4 : \uD63C\uB839\uC758 \uB2EC  (\uB370\uBAA8 \uD074\uB9AC\uC5B4)"
